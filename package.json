{
  "name": "my-project",
  "version": "0.0.1",
  "description": "Make and shake",
  "scripts": {
    "dev": "bun run --bun next dev",
    "dev:local": "bun run --bun next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "docker:dev": "docker compose up web-dev",
    "docker:clean": "docker compose down -v --remove-orphans && docker compose rm -f",
    "docker:fresh": "bun run docker:clean && bun run docker:dev",
    "docker:build": "docker compose --progress=plain build web-prod",
    "docker:prod": "docker compose up -d web-prod",
    "docker:release": "docker compose --progress=plain build web-prod && docker compose up -d web-prod",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "kill3000": "lsof -ti :3000 | xargs -r kill -9 2>/dev/null || echo 'Port 3000 is free'"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  }
}
